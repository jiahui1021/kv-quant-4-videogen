+    def _attention_with_incremental_cache(
+        self, roped_query, roped_key, value, kv_cache, quantizer, current_start
+    ):
+        """Append-only quantized cache for methods that quantize post-RoPE keys.
+
+        Neither KIVI nor QuaRot re-quantizes history.  The current block stays
+        in the quantizer's mutable write buffer, so repeated denoising steps
+        replace it, and a block is packed only once the next block arrives.
+        QuaRot additionally rotates Q/K by the same Hadamard and caches V in
+        the rotated basis; the attention output is rotated back here, standing
+        in for the inverse QuaRot folds into ``o_proj``.
+        """
+        rotated = bool(getattr(quantizer, "requires_special_attention_backend", False))
+        if rotated:
+            roped_query, roped_key = quantizer.prepare_attention_qk(roped_query, roped_key)
+            value = quantizer.prepare_value(value)
+        if self.sink_size and self.local_attn_size != -1:
+            raise NotImplementedError(
+                "The incremental quantized cache does not support sink retention"
+            )
+        b, num_new_tokens, n, d = roped_key.shape
+        current_end = int(current_start) + int(num_new_tokens)
+        kv_cache_size = kv_cache.get("kv_cache_size", None)
+        if kv_cache_size is None:
+            if isinstance(kv_cache.get("k"), torch.Tensor) and kv_cache["k"].ndim == 4:
+                kv_cache_size = int(kv_cache["k"].shape[1])
+            else:
+                kv_cache_size = int(self.max_attention_size)
+        kv_cache_size = int(kv_cache_size)
+
+        state = kv_cache.get("quant_state")
+        if state is None:
+            state = quantizer.init_state(
+                meta={
+                    "shape": (int(b), 0, int(n), int(d)),
+                    "tensor_dtype": value.dtype,
+                    "device": value.device,
+                    "cache_space": "post_rope",
+                    "attention_space": rotated,
+                }
+            )
+
+        if self.local_attn_size != -1 and current_end > kv_cache["global_end_index"].item():
+            requested_eviction = max(
+                int(state.get("num_tokens", 0)) + int(num_new_tokens) - kv_cache_size, 0
+            )
+            if requested_eviction > 0:
+                # A partial packed group is retained; the attention slice
+                # below still enforces the window.
+                quantizer.evict_prefix(state, requested_eviction)
+
+        quantizer.append_kv(
+            state,
+            roped_key,
+            value,
+            meta={
+                "tensor_dtype": value.dtype,
+                "absolute_start": int(current_start),
+                "absolute_end": current_end,
+                "cache_space": "post_rope",
+                "already_rotated": rotated,
+                "attention_space": rotated,
+            },
+        )
+        cache_k, cache_v = quantizer.materialize_kv(
+            state,
+            meta={
+                "tensor_dtype": value.dtype,
+                "shape": (int(b), 0, int(n), int(d)),
+                "device": value.device,
+            },
+        )
+        local_end_index = int(state["num_tokens"])
+        attention_start = max(0, local_end_index - int(self.max_attention_size))
+        x = attention(
+            roped_query,
+            cache_k[:, attention_start:local_end_index],
+            cache_v[:, attention_start:local_end_index],
+        )
+        if rotated:
+            x = quantizer.restore_attention_output(x).type_as(value)
+        kv_cache["global_end_index"].fill_(current_end)
+        kv_cache["local_end_index"].fill_(local_end_index)
+        kv_cache["quant_state"] = state
+        kv_cache["kv_cache_size"] = kv_cache_size
+        kv_cache["batch_size"] = int(b)
+        kv_cache["num_heads"] = int(n)
+        kv_cache["head_dim"] = int(d)
+        # Drop persistent BF16 cache residency for quantized methods.
+        kv_cache["k"] = value.new_empty(0)
+        kv_cache["v"] = value.new_empty(0)
+        return x
+
